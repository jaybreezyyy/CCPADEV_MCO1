<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Animo Eats</title>
    <link rel="stylesheet" href="/css/view_profile.css" />
    <link href="https://fonts.googleapis.com/css2?family=Gelasio:ital,wght@0,400..700;1,400..700&family=Hanuman:wght@100;300;400;700;900&family=Kalam:wght@300;400;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="page">
      <div class="container">
        <div class="header">
          <div class="logo">
            <a href="/" class="home_button">
              <span class="green">A</span>nimo <span class="green">E</span>ats
            </a>
          </div>

          <div class="searchbar">
            <form action="/search" method="GET">
              <input type="text" name="query" placeholder="Search Here..." required />
              <button type="submit" class="search_button">&#128269;</button>
            </form>
          </div>

          <div class="profilebuttons">
            <a href="/login_as" class="login_button"> Log In </a>
            <a href="/signup" class="signup_button"> Sign Up </a>
            <a href="/view_profile" class="view_profile_button">
              View Profile
            </a>
          </div>
        </div>

        <div class="content">
          <div class="profile">
              <div >
                <img class="profilepicture" src="/uploads/{{user.avatar}}" alt="User Avatar">
              </div>


            <div class="info">
              <div class="username"><h1>{{user.username}}</h1></div>
              <div class="description">
                  <p>{{user.short_description}}</p>
                
              </div>
              <div class="options">
                <div class="editbutton">
                  <a href="/edit_profile" class="buttondesign">
                    Edit Profile
                  </a>
                </div>

                <div class="editbutton">
                  <a href="/logout" class="buttondesign">Logout</a>
                </div>
              </div>
            </div>
          </div>

              <div class="review">
      <div class="reviewtitle"><h1>Recent Reviews</h1></div>

      {{#if reviews.length}}
        {{#each reviews}}
          <div class="reviewpost">
            <div class="establishmentname">
              Establishment:
              <span><a href="/view_resto/{{this.restoName}}" class="establishmentname">{{this.restoName}}</a></span>
            </div>
            <div class="title">Title: {{this.title}}</div>
            <div class="ratingdiv">
              Rating: 
              <span class="rating">
                {{#times this.rating}}★{{/times}} <!-- Display star rating -->
              </span>
              <span><a href="/edit_review/{{this._id}}" class="editreview"></a></span>
            </div>
            <div class="body">
              <p>{{this.body}}</p>
            </div>
          </div>
        {{/each}}
      {{else}}
        <p style="text-align: center; font-family: 'Hanuman', serif;">
          No reviews yet. Write your first review!
        </p>
      {{/if}}
    </div>


          
        </div>
      </div>

      <div class="footer">
        <div class="contact_information">
          <p><span class="green">&phone; </span>Contact Us</p>
          <p><b>Phone: </b>091231231123</p>
          <p><b>Email: </b>animoeats@gmail.com</p>
        </div>
        <div class="address">
          <p><span class="green">&#127988;</span> Address</p>
          <p>2401 Taft Ave, Malate, Manila, 1004 Metro Manila</p>
        </div>
        <div class="copyright_notice">
          <p><span class="green">&#9888;</span> Copyright Notice</p>
          <p class="copyright_text">
            © 2025 Animo Eats. All Rights Reserved. This work, including all
            text, images, graphics, and other content, is protected by copyright
            laws and international treaties. Unauthorized reproduction,
            distribution, or modification of any part of this work is strictly
            prohibited without prior written permission from the copyright
            owner.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
