<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Animo Eats</title>
  <link rel="stylesheet" href="/css/edit_review.css">
  <link href="https://fonts.googleapis.com/css2?family=Kalam:wght@300;400;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Gelasio:ital,wght@0,400..700;1,400..700&family=Hanuman:wght@100;300;400;700;900&family=Kalam:wght@300;400;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="page">
    <div class="container">
      <div class="header">
        <div class="logo">
          <a href="/" class="home_button">
            <span class="green">A</span>nimo <span class="green">E</span>ats
          </a>
        </div>

        <div class="searchbar">
          <form action="/search" method="GET">
              <input type="text" name="query" placeholder="Search Here..." required />
              <button type="submit" class="search_button">&#128269;</button>
          </form>
        </div>

        <div class="profilebuttons">
          <a href="/login_as" class="login_button"> Log In </a>
          <a href="/signup" class="signup_button"> Sign Up </a>
          <a href="/view_profile" class="view_profile_button">
            View Profile
          </a>
        </div>
      </div>

      <div class="content">
        <div class="title">
          <h1>Edit <span class="review">Review</span></h1>
        </div>

        <div class="inputs">
          <div class="titleblock">
            <div class="titletext">Edit Title:</div>
            
            <!-- Main Form for Editing Review -->
            <form id="editReviewForm" action="/edit_review/{{review._id}}" method="POST">
              <input type="text" name="title" class="userinput" value="{{review.title}}" required>

              <div class="titletext">Edit Rating:</div>
              <div class="star-rating">
                <input type="radio" id="star5" name="rating" value="5" {{#if (eq review.rating 5)}}checked{{/if}}>
                <label for="star5">★</label>
                
                <input type="radio" id="star4" name="rating" value="4" {{#if (eq review.rating 4)}}checked{{/if}}>
                <label for="star4">★</label>
                
                <input type="radio" id="star3" name="rating" value="3" {{#if (eq review.rating 3)}}checked{{/if}}>
                <label for="star3">★</label>
                
                <input type="radio" id="star2" name="rating" value="2" {{#if (eq review.rating 2)}}checked{{/if}}>
                <label for="star2">★</label>
                
                <input type="radio" id="star1" name="rating" value="1" {{#if (eq review.rating 1)}}checked{{/if}}>
                <label for="star1">★</label>
              </div>

              <div class="titletext">Edit Body:</div>
              <textarea  name="body" class="review-input" required>{{review.body}}</textarea>
            </form>

            <!-- Delete Form (Separate for deleting) -->
            <form id="deleteReviewForm" action="/delete_review/{{review._id}}" method="POST"></form>

            <!-- Buttons for saving and deleting -->
            

          </div>
          <div class="saveanddelete">
              <button type="button" class="buttondesign" onclick="submitEditForm()">Save Changes</button>              
              <button type="button" class="deletebuttondesign" onclick="submitDeleteForm()">Delete Review</button>
            </div>
        </div>
      </div>
    </div>
   
    <div class="footer">
      <div class="contact_information">
          <p><span class="green">&phone; </span>Contact Us</p>
          <p><b>Phone: </b>091231231123</p>
          <p><b>Email: </b>animoeats@gmail.com</p>
      </div>
      <div class="address">
          <p><span class="green">&#127988;</span> Address</p>
          <p>2401 Taft Ave, Malate, Manila, 1004 Metro Manila</p>
      </div>
      <div class="copyright_notice">
          <p><span class="green">&#9888;</span> Copyright Notice</p>
          <p class="copyright_text">© 2025 Animo Eats. All Rights Reserved. This work, including all text, images, graphics, and other content, is protected by copyright laws and international treaties. Unauthorized reproduction, distribution, or modification of any part of this work is strictly prohibited without prior written permission from the copyright owner.</p>
      </div>
    </div>

    <!-- JavaScript for triggering form submission -->
    <script>
      function submitEditForm() {
        document.getElementById("editReviewForm").submit();
      }

      function submitDeleteForm() {
        if (confirm("Are you sure you want to delete this review?")) {
          document.getElementById("deleteReviewForm").submit();
        }
      }
    </script>

  </div>
</body>
</html>
