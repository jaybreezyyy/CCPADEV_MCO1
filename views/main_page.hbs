<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>AnimoEats</title>
    <link rel="stylesheet" href="/css/style_main.css" />
    <link href="https://fonts.googleapis.com/css2?family=Gelasio:ital,wght@0,400..700;1,400..700&family=Hanuman:wght@100;300;400;700;900&family=Kalam:wght@300;400;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="page">
      <div class="container">
        <div class="header">
          <div class="logo">
            <a href="/" class="home_button">
              <span class="green">A</span>nimo <span class="green">E</span>ats
            </a>
          </div>

          <div class="searchbar">
            <form>
              <input type="text" placeholder="Search Here..." />
              <button class="search_button">&#128269;</button>
            </form>
          </div>

          <div class="profilebuttons">
            <a href="/login_as" class="login_button"> Log In </a>
            <a href="/signup" class="signup_button"> Sign Up </a>
            <a href="/view_profile" class="view_profile_button">
              View Profile
            </a>
          </div>
        </div>
        <div class="body">

          <div class="campus_facade">
            <div class="slogan_text">
              <p class="slogan">
                Exploring Local Flavors in <span class="green">DLSU</span>
              </p>
            </div>
            <img align="right" class="campus_image" src="/images/campus.jpg" />
          </div>

          <div class="local-flavors-section">
            <div class="middle_text">
              <h1>Local <span class="green">Flavors</span></h1>
            </div>
            <div class="gallery-container">
              <img src="images/arrow_left.png" id ="leftArrow">
              <div class="restogallery">
                  {{#each restosList}}
                  
                    <span>
                      <div class="review_name">{{this.name}}</div>
                      <p class="stars">{{this.rating}}</p>
                      <a href="/view_resto/{{this.name}}">             <!-- ?? -->
                        <img src="{{this.storeImage}}" />
                      </a>
                      <p class="review_desc">
                        {{truncate this.description 30}}
                      </p>
                    </span>
                    
                  {{/each}}
                 
              </div>
              <img src="images/arrow_right.png" id ="rightArrow">
            </div>

        <div class="footer">
          <div class="contact_information">
            <p><span class="green">&phone; </span>Contact Us</p>
            <p><b>Phone: </b>091231231123</p>
            <p><b>Email: </b>animoeats@gmail.com</p>
          </div>
          <div class="address">
            <p><span class="green">&#127988;</span> Address</p>
            <p>2401 Taft Ave, Malate, Manila, 1004 Metro Manila</p>
          </div>
          <div class="copyright_notice">
            <p><span class="green">&#9888;</span> Copyright Notice</p>
            <p class="copyright_text">
              © 2025 Animo Eats. All Rights Reserved. This work, including all
              text, images, graphics, and other content, is protected by
              copyright laws and international treaties. Unauthorized
              reproduction, distribution, or modification of any part of this
              work is strictly prohibited without prior written permission from
              the copyright owner.
            </p>
          </div>
        </div>
      </div>
    </div>

    <script src="/js/main.js" ></script>
  </body>
</html>
